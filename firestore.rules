
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || request.auth.uid == 'LXaJZDm6tNUQLh3ooghcg6EQgJ43');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isDemo == false
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.user is string
        && request.resource.data.user.size() > 0 && request.resource.data.user.size() <= 60
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1000
        && request.resource.data.images is list && request.resource.data.images.size() <= 4
        && request.resource.data.createdAt == request.time
      );
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeShowcaseSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Leitura: admin, ou a cliente dona do pedido (userId = uid dela).
      // Pedidos antigos sem userId: a dona pelo e-mail da conta (usado em "Meus pedidos").
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && resource.data.userId == null
            && resource.data.customer.email == request.auth.token.email);

      // Criar: qualquer pessoa (checkout de visitante), mas sempre como 'pending'
      // e sem apontar o pedido para o uid de outra pessoa.
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending'
        && (request.resource.data.userId == null
            || (isSignedIn() && request.resource.data.userId == request.auth.uid))
      );

      // Atualizar: admin faz tudo. Cliente so edita enquanto 'pending' (voltar uma etapa
      // do checkout) e nao pode mudar status nem o dono. A cliente logada tambem pode
      // "puxar" pedido antigo sem dono para o proprio uid, se o e-mail for o dela.
      allow update: if isAdmin()
        || (resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.userId == resource.data.userId)
        || (isSignedIn()
            && resource.data.userId == null
            && request.resource.data.userId == request.auth.uid
            && resource.data.customer.email == request.auth.token.email
            && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // Colecoes usadas apenas pelo painel admin (antes caiam na regra "negar tudo")
    match /carts/{id} { allow read, write: if isAdmin(); }
    match /customers/{id} { allow read, write: if isAdmin(); }
    match /promotions/{id} { allow read, write: if isAdmin(); }
    match /analytics/{id} { allow read, write: if isAdmin(); }

    match /roles_admin/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{s} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
